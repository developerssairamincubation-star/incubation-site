# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables.

# --- Admin sign-in (/admin) --------------------------------------------------
# Generate the hash and a session secret with:  npm run admin:hash
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Added automatically when you connect the stores in Vercel ---------------
# Neon (Vercel → Storage → Create Database → Neon)
DATABASE_URL=
# Vercel Blob (Vercel → Storage → Create → Blob). Leave empty locally and
# uploads are saved to public/uploads instead.
BLOB_READ_WRITE_TOKEN=

# --- Application emails (/apply and /rnd forms) -------------------------------
# Brevo → SMTP & API → API Keys. The sender must be verified in Brevo
# (Senders, Domains & Dedicated IPs). Applications are emailed to
# APPLICATION_EMAIL in src/lib/data.ts.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
